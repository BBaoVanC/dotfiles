# Adapted from my waybar service file
[Unit]
Description=Noctalia Native Shell
Documentation=https://docs.noctalia.dev/noctalia/
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
#StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/noctalia
#ExecReload=kill -SIGUSR2 $MAINPID
Restart=on-failure
#RestartSec=5s
Slice=session.slice

# no [Install] section because this is generic, can be enabled using add-wants.
# systemctl --user add-wants niri.service noctalia.service
